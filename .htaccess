# Used when the whole repository is deployed into public_html (e.g. Hostinger Git deploy).
# Every request is routed into public/, so app/, .git and config files are never reachable.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Only a path that starts with public/ is left alone. Matching "/public/" anywhere in the address would
    # also let through /scripts/seed-demo.php/public/, which runs a script outside public/.
    RewriteRule ^public/ - [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
