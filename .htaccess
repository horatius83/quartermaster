# Used when the whole repository is deployed into public_html (e.g. Hostinger Git deploy).
# Every request is routed into public/, so app/, .git and config files are never reachable.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
